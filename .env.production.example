APP_NAME=LocalLife AI SaaS
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=https://api.example.com
FRONTEND_URL=https://example.com

# Use long random values in production. AES_SECRET must be 32 chars.
JWT_SECRET=replace-with-a-long-random-production-secret
AES_SECRET=replace-with-32-char-production-key
RATE_LIMIT_PER_MINUTE=300

# Docker internal MySQL address.
MYSQL_DSN=saas_user:replace-with-db-password@tcp(mysql:3306)/saas_billing?charset=utf8mb4&parseTime=True&loc=Local

# Alipay sandbox for staging. Set false and replace keys when going live.
ALIPAY_SANDBOX=true
ALIPAY_APP_ID=2021000000000000
ALIPAY_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_ALIPAY_APP_PRIVATE_KEY\n-----END PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_ALIPAY_PUBLIC_KEY\n-----END PUBLIC KEY-----"
ALIPAY_NOTIFY_URL=https://api.example.com/api/v1/payments/callback/alipay
ALIPAY_RETURN_URL=https://example.com/payment/return
