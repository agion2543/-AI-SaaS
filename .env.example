APP_NAME=SaaS Billing Platform
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-very-strong-secret
# Development-only example; production needs a private random 32-byte value.
# The value is used directly as UTF-8 bytes, not decoded from hexadecimal.
AES_SECRET=replace-with-32-byte-placeholder
INITIAL_ADMIN_USERNAME=admin
# For a new development database only: set a private value to create its first admin; otherwise leave empty.
INITIAL_ADMIN_PASSWORD=
RATE_LIMIT_PER_MINUTE=120
OTP_SEND_RATE_LIMIT_PER_IP_PER_MINUTE=10
# Leave empty unless behind a reverse proxy; configure only its actual IP/CIDR(s).
TRUSTED_PROXIES=
MYSQL_DSN=root:replace-with-local-db-password@tcp(mysql:3306)/saas_billing?charset=utf8mb4&parseTime=True&loc=Local
# Schema is built only by the versioned migrator: run the schema-migrate
# service (default Compose) or `go run ./cmd/schema-migrate` before starting
# the backend. DB_AUTO_MIGRATE defaults to false; set it to true only for a
# throwaway local experiment database, never for a shared or deployed one.
ALIPAY_SANDBOX=true
ALIPAY_APP_ID=2021000000000000
ALIPAY_APP_PRIVATE_KEY=replace-with-your-alipay-app-private-key
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_ALIPAY_SANDBOX_PUBLIC_KEY\n-----END PUBLIC KEY-----"
ALIPAY_NOTIFY_URL=http://localhost:8080/api/v1/payments/callback/alipay
ALIPAY_RETURN_URL=http://localhost:5173/payment/return

# AI provider uses OpenAI-compatible /chat/completions protocol.
# Domestic examples:
# DeepSeek: AI_BASE_URL=https://api.deepseek.com/v1, AI_MODEL=deepseek-chat
# Alibaba Bailian DashScope compatible mode: AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1, AI_MODEL=qwen-plus
# Zhipu / Kimi / other domestic providers: use their OpenAI-compatible base URL and model name when available.
# Keep AI_ENABLED=false until API key, quota and billing alert are ready.
AI_ENABLED=false
AI_PROVIDER=template
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=20
